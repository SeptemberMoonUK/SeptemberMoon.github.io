rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{adminId} {
      // Admin membership is created manually in Firebase Console.
      allow read: if signedIn() && request.auth.uid == adminId;
      allow write: if false;
    }

    match /products/{productId} {
      // Visitors can only read products that are explicitly visible.
      allow read: if resource.data.visible == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /settings/site {
      // Maintenance status/text must be readable before login.
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }
  }
}
